{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // WebWorker is needed by the simulator worker entry: without it `self` is
    // typed as Window and transferable postMessage overloads do not resolve.
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["vite/client", "node"],
    // vite.config.ts imports devtools/*.ts by its real extension (the native config loader needs it).
    "allowImportingTsExtensions": true
  },
  "include": ["src", "devtools", "vite.config.ts"]
}
