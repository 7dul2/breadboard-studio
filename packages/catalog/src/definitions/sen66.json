  "body": { "size_um": [41900, 41900], "height_um": 12400, "standoff_um": 0, "corner_radius_um": 1500 },
  "pins": [
    { "name": "VDD", "local_um": [14000, 40600], "kind": "terminal" },
    { "name": "GND", "local_um": [16500, 40600], "kind": "terminal" },
    { "name": "SDA", "local_um": [19000, 40600], "kind": "terminal" },
    { "name": "SCL", "local_um": [21500, 40600], "kind": "terminal" },
    { "name": "SEL", "local_um": [24000, 40600], "kind": "terminal" },
    { "name": "NC", "local_um": [26500, 40600], "kind": "terminal" }
  ],
  "pin_meta": {
