{
  "kind": "component",
  "id": "esp32s3_devkit_generic",
  "version": 1,
  "name": "ESP32-S3 开发板（通用双排针模板）",
  "manufacturer": "generic",
  "model": "ESP32-S3-DevKitC-1 style, dual USB-C, N16R8",
  "description": "可配置的双排针开发板模板：每侧针数、排距、针名和外形都可通过 params 修改。默认值取自 Espressif ESP32-S3-DevKitC-1 v1.1 的 44 针排布，双 USB-C 克隆板通常沿用同样的针序，但外形和排距必须以实物为准。",
  "category": "mcu",
  "mount": "breadboard",
  "origin": "top_left",
  "preferred_rotation_deg": 90,
  "generator": {
    "type": "dual_row_header",
    "first_pin_um": 4830
  },
  "params_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "pins_per_side": {
        "type": "integer",
        "minimum": 1,
        "maximum": 40,
        "description": "每侧针数"
      },
      "row_spacing_um": {
        "type": "integer",
        "minimum": 2540,
        "description": "两排针中心距（µm）。DevKitC-1 常见 22860（0.9 in），部分板为 25400（1.0 in）。"
      },
      "body_size_um": {
        "type": "array",
        "items": {
          "type": "integer"
        },
        "minItems": 2,
        "maxItems": 2,
        "description": "板体宽×长（µm）"
      },
      "left_pin_names": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "左列自上而下针名"
      },
      "right_pin_names": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "右列自上而下针名"
      }
    }
  },
  "params_default": {
    "pins_per_side": 22,
    "row_spacing_um": 22860,
    "body_size_um": [
      25500,
      63000
    ],
    "left_pin_names": [
